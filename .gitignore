# Python
__pycache__/
*.pyc
.pytest_cache/

# Virtual environments
.venv/

# Generated CLI output
5gcap/out.json

# Sandbox runtime logs (bind-mounted, root-owned, regenerated on every run)
sandbox/core/log/*.log

# 3GPP spec archive cache (regenerable via triage/scripts/build_corpus.py)
triage/corpus/cache/

# Triage episodic memory (runtime records, written post-hoc at consolidation)
triage/memory/

# Triage eval results (runtime records; regenerated on every explicit run)
triage/evals/results.json

# Dispatch eval results + per-run work dirs (runtime records; regenerated
# on every explicit run)
dispatch/evals/results.json
dispatch/evals/work/

# Dispatch pipeline runtime artifacts (Incident Records + the checkpoint
# store; created by `dispatch handle`, regenerable per incident)
dispatch/records/
dispatch/state/

# Claude Code local session settings
.claude/settings.local.json

# Unrelated graphify-skill inputs/output (other projects, regenerable graph)
/raw_graphify/
/graphify-out/
