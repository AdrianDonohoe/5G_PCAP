# PLMN: Open5GS' own canonical test PLMN (matches the subscriber seed script
# and RAN configs) — see docs/adr/0002-open5gs-ueransim-sandbox.md
MCC=999
MNC=70
TAC=1
NETWORK_NAME=5gcap-sandbox
MAX_NUM_UE=1024

CORE_SUBNET=10.53.0.0/24

MONGO_IP=10.53.0.2
NRF_IP=10.53.0.3
SCP_IP=10.53.0.4
AUSF_IP=10.53.0.5
UDR_IP=10.53.0.6
UDM_IP=10.53.0.7
PCF_IP=10.53.0.8
BSF_IP=10.53.0.9
NSSF_IP=10.53.0.10
AMF_IP=10.53.0.11
SMF_IP=10.53.0.12
UPF_IP=10.53.0.13
UPF_ADVERTISE_IP=10.53.0.13

SMF_DNS1=8.8.8.8
SMF_DNS2=8.8.4.4

UPF_TUNTAP_MODE=tun
UPF_INTERNET_APN_IF_NAME=ogstun
UPF_IMS_APN_IF_NAME=ogstun2
UE_IPV4_INTERNET=192.168.100.0/24
UE_IPV4_IMS=192.168.101.0/24

# IMS/4G-only knobs the vendored smf/upf init scripts touch unconditionally
# even in 5G SA mode. Not meaningful for this sandbox's scope (Registration +
# PDU session establishment, APN=internet only) but must be set to something.
PCSCF_IP=10.53.0.14
PCRF_IP=10.53.0.15
PCRF_BIND_PORT=3873
OCS_IP=10.53.0.16
OCS_BIND_PORT=3872
OSMOEPDG_IP=10.53.0.17
